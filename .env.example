# Copy this file to `.env` at the repo root and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Groq Cloud API key — used for AI editing-plan generation.
API_KEY="your_groq_api_key_here"

# Pexels API key — used to download B-roll / stock footage.
PEXELS_API_KEY="your_pexels_api_key_here"


# Caption removal (external VideoSubtitleRemover tool — see CLAUDE.md for setup).
# Optional: only needed for the burned-in-caption removal feature.
# Path to the cloned repo and the python interpreter of its dedicated virtualenv.
SUBTITLE_REMOVER_DIR="third_party/VideoSubtitleRemover"
SUBTITLE_REMOVER_PYTHON="third_party/VideoSubtitleRemover/.venv/bin/python"
# Set to 1/true on a machine with a supported NVIDIA GPU to run inpainting on the GPU.
SUBTITLE_REMOVER_USE_GPU="0"
